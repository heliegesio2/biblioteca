<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Versões centralizadas por projeto. Cada pacote entra aqui na fase em que passa a
    ser usado de fato (ver docs/implementation-plan.md) — nada é adicionado adiantado.
  -->
  <ItemGroup>
    <!-- src/Biblioteca.Api — fase 0 -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />

    <!-- src/Biblioteca.Api — fase 1 (persistência). EFCore.* fixado na mesma versão do
         Design para toda a árvore de dependências (CentralPackageTransitivePinning) —
         Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 aceita qualquer 10.x >= 10.0.4. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />

    <!-- src/Biblioteca.Api — fase 2 (infraestrutura CQRS) -->
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />

    <!-- src/Biblioteca.Api — fase 5 (cache) -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />
    <PackageVersion Include="StackExchange.Redis" Version="3.2.1" />

    <!-- tests/* — fase 0 -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />

    <!-- tests/Biblioteca.IntegrationTests — fase 2 (Testcontainers + WebApplicationFactory) -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Respawn" Version="7.0.0" />

    <!-- tests/Biblioteca.IntegrationTests — fase 5 (Redis real via Testcontainers) -->
    <PackageVersion Include="Testcontainers.Redis" Version="4.15.0" />
  </ItemGroup>

</Project>
