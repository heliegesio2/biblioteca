{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Loans": {
    "LoanPeriodDays": 14,
    "MaxActiveLoansPerUser": 5
  },
  "Idempotency": {
    "RetentionHours": 24
  },
  "Cache": {
    "BookTtlSeconds": 300,
    "AvailabilityTtlSeconds": 30
  },
  "Auth": {
    "Issuer": "biblioteca",
    "Audience": "biblioteca"
  }
}
